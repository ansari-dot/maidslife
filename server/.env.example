NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/maidslife
JWT_ACCESS_SECRET=maidslife_super_secret_access_token_key_2026
JWT_REFRESH_SECRET=maidslife_super_secret_refresh_token_key_2026
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_DOMAIN=localhost
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Maidslife Admin <noreply@maidslife.com>"
UPLOAD_MAX_SIZE_MB=8
CLIENT_URL=http://localhost:3000

# Ziina Payment Gateway
ZIINA_MODE=test
ZIINA_BASE_URL=https://api-v2.ziina.com
ZIINA_API_KEY=your_ziina_test_api_key
ZIINA_PROD_API_KEY=your_ziina_prod_api_key
ZIINA_WEBHOOK_SECRET=your_ziina_webhook_secret
